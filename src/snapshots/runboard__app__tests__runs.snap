<h1>Runs</h1><div class="actions status-summary"><a href="/?sort=name&amp;state=running">2 running</a><a href="/?sort=name&amp;state=slow">0 no recent reports</a><a href="/?sort=name&amp;state=failed">0 failed</a><a href="/?sort=name&amp;state=completed">0 completed</a></div><form id="run-filters" class="filters" action="/"><fieldset><legend>Find runs</legend><label>Project<input name="project" value=""></label><label>Search runs<input name="name" value=""></label><label>State <select name="state"><option value="" selected="">All</option><option value="running">running</option><option value="slow">slow</option><option value="stopped">stopped</option><option value="completed">completed</option><option value="failed">failed</option><option value="cancelled">cancelled</option><option value="recorded">recorded</option><option value="no-data">no-data</option></select></label></fieldset><details><summary>More filters and sorting · 1 active</summary><div class="columns"><fieldset><legend>Metadata</legend><label>Trainer<input name="trainer" value=""></label><label>Tag<input name="tag" value=""></label></fieldset><fieldset><legend>Metric range</legend><label>Metric<input name="metric" value=""></label><label>Minimum<input name="minimum" value=""></label><label>Maximum<input name="maximum" value=""></label></fieldset><fieldset><legend>Order</legend><label>Sort <select name="sort"><option value="active">active</option><option value="recent">recent</option><option value="name" selected="">name</option><option value="metric">metric</option></select></label><label>Descending <input type="checkbox" name="descending" value="1"></label></fieldset></div></details><div class="actions"><button>Filter</button><a href="/">Reset</a></div></form><p>2 matching runs · page 1 of 1 · select up to eight.</p><form id="run-selection" action="/compare"><div class="actions selection-toolbar"><span id="selection-count" role="status">Select runs to compare</span><button>Compare selected</button><button formaction="/export">CSV</button><button formaction="/report">Static report</button><button id="selection-clear" type="button" hidden="">Clear selection</button></div><div class="table-scroll" role="region" aria-label="Runs table" tabindex="0"><table><tr><th>Select</th><th>Project / run</th><th>State</th><th>Step</th><th>Latest metrics</th><th>Last report</th></tr><tr><td><input aria-label="Select a/same" type="checkbox" name="run" value="a/same"></td><td><a href="/run?run=a%2Fsame">a/same</a><div class="queue-task"><a href="/jobs?completed=1#task-a-7">Pueue #7</a></div></td><td><span class="state" data-state="running">running</span></td><td>2</td><td>loss: 1<br>custom: 0.75</td><td><time data-time="[timestamp]">[age]</time></td></tr><tr><td><input aria-label="Select b/same" type="checkbox" name="run" value="b/same"></td><td><a href="/run?run=b%2Fsame">b/same</a><div class="queue-task">Pueue #7</div></td><td><span class="state" data-state="running">running</span></td><td>2</td><td>loss: 2<br>custom: 0.75</td><td><time data-time="[timestamp]">[age]</time></td></tr></table></div></form>
